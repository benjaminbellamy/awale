# SPDX-License-Identifier: AGPL-3.0-or-later

project('awale', ['c', 'vala'],
  version: '1.2.1',
  license: 'AGPL-3.0-or-later',
  meson_version: '>= 1.0.0',
  default_options: [
    # Every C file in this project is generated by valac, so C warnings report
    # on the code generator rather than on anything we wrote. Vala warnings are
    # emitted by valac itself and are not affected by this.
    'warning_level=0',
    'c_std=gnu11',
  ],
)

gnome = import('gnome')
i18n = import('i18n')

glib_dep = dependency('glib-2.0', version: '>= 2.76')
gobject_dep = dependency('gobject-2.0')
gio_dep = dependency('gio-2.0')
gtk_dep = dependency('gtk4', version: '>= 4.14')
adw_dep = dependency('libadwaita-1', version: '>= 1.5')
# The board renderer lays seeds out with sqrt() and ceil().
math_dep = meson.get_compiler('c').find_library('m', required: false)

app_id = 'fr.benjaminbellamy.Awale'
app_name = 'Awalé'
gettext_package = 'awale'

config_data = configuration_data()
config_data.set_quoted('APP_ID', app_id)
config_data.set_quoted('APP_NAME', app_name)
config_data.set_quoted('VERSION', meson.project_version())
config_data.set_quoted('GETTEXT_PACKAGE', gettext_package)
config_data.set_quoted('LOCALEDIR', get_option('prefix') / get_option('localedir'))
configure_file(output: 'config.h', configuration: config_data)

config_inc = include_directories('.')

# valac turns _("...") into a gi18n-lib.h macro that needs this at C compile
# time, in every generated file rather than only where config.h is included.
add_project_arguments('-DGETTEXT_PACKAGE="' + gettext_package + '"', language: 'c')

subdir('src/core')
subdir('src/cli')
subdir('src/ui')
subdir('data')
subdir('po')
subdir('tests')

gnome.post_install(
  glib_compile_schemas: true,
  gtk_update_icon_cache: true,
  update_desktop_database: true,
)
