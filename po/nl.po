#: src/ui/window.blp:111
msgid "_Difficulty"
msgstr "_Moeilijkheid"

#: src/ui/window.blp:114
msgid "_Easy"
msgstr "_Makkelijk"

#: src/ui/window.blp:120
msgid "_Medium"
msgstr "_Gemiddeld"

#: src/ui/window.blp:126
msgid "_Hard"
msgstr "_Moeilijk"

#: src/ui/window.blp:133
msgid "_Language"
msgstr "_Taal"

#: src/ui/window.blp:136
